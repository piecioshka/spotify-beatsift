# Client ID from https://developer.spotify.com/dashboard
# Copy this file to .env and paste your own value.
VITE_SPOTIFY_CLIENT_ID=

# Address Spotify returns to after login. Must match the dashboard entry exactly.
# Empty = current page origin + /callback, which locally means
# http://127.0.0.1:3000/callback.
VITE_SPOTIFY_REDIRECT_URI=

# Public address of the deployed site, e.g. https://beatsift.example. Enables the
# canonical link, og:url, the absolute Open Graph image, JSON-LD and sitemap.xml.
# May stay empty locally.
VITE_SITE_URL=
